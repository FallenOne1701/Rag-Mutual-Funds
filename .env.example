# Groq LLM (required for generation / classification from Phase 3+)
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults match Docs/Architecture.md §11.2)
# Primary + fast models (Llama 3.3 / 3.1 on Groq are decommissioned)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# gpt-oss spends part of the budget on reasoning tokens; 256 can return empty text
GROQ_MAX_TOKENS=512

# Free-tier quota guard (tokens per minute binds first). Over budget -> Groww link.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000
GROQ_TOKENS_PER_MINUTE=8000
GROQ_TOKENS_PER_DAY=200000
GROQ_BUDGET_ENABLED=true

# Query Classifier: rules first; Groq only for in-domain questions the rules can't label
CLASSIFIER_GROQ_FALLBACK=true

# Chat API
API_RATE_LIMIT_PER_MINUTE=20
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_WARMUP_ON_STARTUP=true
GROQ_TEMPERATURE=0.1
